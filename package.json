{
  "name": "project-management",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi Manajemen Proyek",
  "license": "MIT",
  "author": "Laman",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dev:staff": "cross-env VITE_APP_ROLE=logistics_staff tauri dev",
    "dev:manager": "cross-env VITE_APP_ROLE=manager tauri dev",
    "build:staff": "cross-env VITE_APP_ROLE=logistics_staff tauri build",
    "build:manager": "cross-env VITE_APP_ROLE=manager tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "db:seed": "vite-node src/db/seeds/run-cli.ts",
    "db:reset": "vite-node src/db/seeds/run-reset-cli.ts",
    "lint": "oxlint -c oxlint.config.json",
    "lint:fix": "oxlint -c oxlint.config.json --fix",
    "format": "oxfmt -c oxfmt.config.json src",
    "format:check": "oxfmt -c oxfmt.config.json --check src"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.4.5",
    "@astryxdesign/theme-neutral": "^0.4.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/valibot-form-adapter": "^0.42.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.2",
    "valibot": "^1.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.32",
    "@tanstack/router-plugin": "^1.168.34",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "cross-env": "^10.1.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0"
  }
}
