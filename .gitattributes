# Set default behavior to automatically detect text files and normalize line endings to LF
* text=auto eol=lf

# Source Code & Scripts
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.rs text eol=lf
*.sql text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf

# Windows Command Scripts (Must use CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf

# Config & Markup
*.json text eol=lf
*.jsonc text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Lockfiles
package-lock.json text eol=lf
Cargo.lock text eol=lf

# Binary Files (Prevent any line ending normalization or corruption)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.xlsx binary
*.xls binary
*.docx binary
*.zip binary
*.tar.gz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
